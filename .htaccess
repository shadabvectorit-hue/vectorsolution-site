# VectorIT — canonical URL: https://vectorsolution.it
RewriteEngine On

# Let ACME/security.txt through before any other rule can touch them.
RewriteRule ^\.well-known/ - [L]

# Only the methods this site actually uses. Blocks TRACE/TRACK, which echo the
# request (headers and cookies included) back to the caller.
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|POST)$
RewriteRule .* - [F]

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://vectorsolution.it/$1 [R=301,L]

# www → apex
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://vectorsolution.it/$1 [R=301,L]

# ---- Clean URLs: /about rather than /about.html ----
# Google Search Console verifies by fetching this exact filename, so it must
# never be redirected.
RewriteRule ^google547811663ccac796\.html$ - [L]

# Old .html address -> clean address, 301 so search engines move the ranking
# across and any link already out in the world keeps working. Matching on
# THE_REQUEST means only a real browser request is redirected, never the
# internal rewrite below (which would otherwise loop).
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Drop a trailing slash so /about/ and /about are not two separate URLs.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+?)/$ /$1 [R=301,L,NE]

# Serve the .html file behind the clean address.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]

# Deny dotfiles and VCS/deploy metadata (.git, .gitignore, .cpanel.yml, .env).
# .well-known is already released above.
RewriteRule "(^|/)\.(?!well-known/)" - [F]

# Shared PHP library — included by the endpoints, never requested directly.
RewriteRule ^lib/ - [F]

# Defence in depth: data, backup and source leftovers are never web content,
# even if one is ever copied into the webroot by mistake.
<FilesMatch "(?i)\.(jsonl|log|bak|old|orig|save|swp|sql|ini|sh|yml|yaml|env)$">
  Require all denied
</FilesMatch>

# Custom error page
ErrorDocument 404 /404.html

# A beacon needs a few hundred bytes and the contact form a few kilobytes;
# anything larger is someone tying up a PHP worker.
LimitRequestBody 1048576

ServerSignature Off

# Security headers
<IfModule mod_headers.c>
  # Browsers remember to use HTTPS, so the first plain-http request can't be
  # intercepted. No includeSubDomains — cpanel/webmail hosts are out of scope.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Cross-Origin-Resource-Policy "same-origin"

  # Everything except script-src, which still needs 'unsafe-inline' until the
  # demo's two inline blocks move to a file. These directives alone close off
  # clickjacking, form hijacking and <base> injection.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

  # PHP's version banner tells an attacker which exploits to try.
  Header unset X-Powered-By
  Header always unset X-Powered-By

  # Social scrapers and search engines must still be able to fetch the images.
  <FilesMatch "(?i)\.(jpg|jpeg|png|svg|webp|ico|woff2?)$">
    Header always set Cross-Origin-Resource-Policy "cross-origin"
  </FilesMatch>
</IfModule>

# Basic caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
